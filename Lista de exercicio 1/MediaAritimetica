#include <stdio.h>

int main() {

    float numero1, numero2, numero3, media;

    printf("Digite a primeira nota: ");
    scanf("%f", &numero1);
    printf("Digite a segunda nota: ");
    scanf("%f", &numero2);
    printf("Digite a terceira nota: ");
    scanf("%f", &numero3);

    media = (numero1 + numero2 + numero3) / 3;

    printf("A média aritmética é: %.1f\n", media);
}